# Fusioneer env — copy to .env and fill. See docs/SELF_HOSTING.md
ANTHROPIC_API_KEY=
GITHUB_TOKEN= # PAT with repo+workflow, or GitHub App token (needs repo, workflow)
GITHUB_WEBHOOK_SECRET= # `openssl rand -hex 32` — must match GitHub webhook secret
FUSIONEER_ALLOW_REPOS=sardonic-labs/sourced,sardonic-labs/fiducial
FUSIONEER_DASHBOARD_TOKEN= # `openssl rand -hex 32` — Bearer token for GET /jobs/* /agents (empty = open in dev, warn in prod)
FUSIONEER_DOMAIN=https://fusioneer.yourdomain.xyz
PORT=3000
DATA_DIR=./data
# Optional: override opencode model per-run via --model; default from agent frontmatter
# OPENCODE_API_KEY= # if using opencode provider
