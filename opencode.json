{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["GLOBAL_CTX.md", ".opencode/fusioneer/REVIEW.md"],
  "enabled_providers": ["opencode", "anthropic"],
  "permission": {
    "external_directory": "deny",
    "doom_loop": "ask",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "bash": {
      "*": "ask",
      "git status *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "bun *": "allow",
      "gh *": "allow",
      "gh pr merge*": "deny",
      "rm -rf *": "deny",
      "rm -rf /*": "deny"
    }
  }
}
